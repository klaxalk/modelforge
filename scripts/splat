#!/usr/bin/env bash
# Train nerfstudio splatfacto on a modelforge project and export the splat in the
# project's ENU frame (aligned with the refined cameras and the COLMAP dense mesh).
# Runs modelforge.splat in the CUDA dev container (nerfstudio is in its /opt/nerfstudio venv);
# the GUI Run tab does the same.
#   scripts/splat data/site [--method splatfacto-big] [--iterations 15000] [extra ns-train args]
# Outputs: PROJECT/nerfstudio/ (training run), PROJECT/splat/splat.ply (nerfstudio frame),
#          PROJECT/splat/splat_enu.ply (ENU). Viewer during training: http://localhost:7007
set -euo pipefail
cd "$(dirname "$0")/.."
[[ $# -ge 1 ]] || { echo "usage: $0 PROJECT [--method M] [--iterations N] [ns-train args...]" >&2; exit 2; }
project="$(realpath --relative-to=. "$1")"
shift
MODELFORGE_GPU=1 exec scripts/dev python -m modelforge.splat "$project" "$@"
